<Window x:Class="CrypTool.CrypLLM.LastInvocationDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:CrypTool.CrypLLM.Properties"
        Title="{x:Static properties:Resources.LastInvocationWindowTitle}"
        Width="1100"
        Height="760"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryTextBlock"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   FontFamily="Consolas"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <TabControl Grid.Row="1">
            <TabItem Header="{x:Static properties:Resources.LastInvocationTabContext}">
                <Grid Margin="0,6,0,0">
                    <GroupBox Header="{x:Static properties:Resources.LastInvocationGroupContextBeforeAnswer}">
                        <TextBox x:Name="ContextTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.LastInvocationTabReductions}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="ReductionsComboBox"
                              Grid.Row="0"
                              Margin="0,0,0,6"
                              SelectionChanged="ReductionsComboBox_SelectionChanged"/>

                    <TextBlock x:Name="ReductionMetaTextBlock"
                               Grid.Row="1"
                               Margin="0,0,0,6"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.LastInvocationGroupOriginal}" Margin="0,0,0,6">
                        <TextBox x:Name="ReductionOriginalTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="{x:Static properties:Resources.LastInvocationGroupReduced}">
                        <TextBox x:Name="ReductionShortTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.LastInvocationTabLlmIo}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static properties:Resources.LastInvocationLabelUserQuestion}"/>

                        <ComboBox x:Name="InvocationSelectorComboBox"
                                  Grid.Column="1"
                                  Margin="0,0,12,0"
                                  MinWidth="260"
                                  SelectionChanged="InvocationSelectorComboBox_SelectionChanged"/>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static properties:Resources.LastInvocationLabelHttpRequest}"/>

                        <ComboBox x:Name="HttpRequestSelectorComboBox"
                                  Grid.Column="3"
                                  MinWidth="260"
                                  SelectionChanged="HttpRequestSelectorComboBox_SelectionChanged"/>
                    </Grid>

                    <TextBlock x:Name="HttpExchangeMetaTextBlock"
                               Grid.Row="1"
                               Margin="0,0,0,6"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.LastInvocationGroupRequestJson}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyRequestJsonButton"
                                    Grid.Row="0"
                                    Width="120"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyRequest}"
                                    Click="CopyRequestJsonButton_Click"/>

                            <TextBox x:Name="RawRequestTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="{x:Static properties:Resources.LastInvocationGroupResponseJson}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyResponseJsonButton"
                                    Grid.Row="0"
                                    Width="130"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyResponse}"
                                    Click="CopyResponseJsonButton_Click"/>

                            <TextBox x:Name="RawResponseTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.LastInvocationTabToolCalls}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static properties:Resources.LastInvocationLabelUserQuestion}"/>

                        <ComboBox x:Name="ToolInvocationSelectorComboBox"
                                  Grid.Column="1"
                                  Margin="0,0,12,0"
                                  MinWidth="260"
                                  SelectionChanged="ToolInvocationSelectorComboBox_SelectionChanged"/>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static properties:Resources.LastInvocationLabelToolCall}"/>

                        <ComboBox x:Name="ToolSelectorComboBox"
                                  Grid.Column="3"
                                  MinWidth="260"
                                  SelectionChanged="ToolSelectorComboBox_SelectionChanged"/>
                    </Grid>

                    <TextBlock x:Name="ToolCallMetaTextBlock"
                               Grid.Row="1"
                               Margin="0,0,0,6"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.LastInvocationGroupToolRequestJson}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyToolRequestButton"
                                    Grid.Row="0"
                                    Width="150"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyToolRequest}"
                                    Click="CopyToolRequestButton_Click"/>

                            <TextBox x:Name="ToolRequestTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="{x:Static properties:Resources.LastInvocationGroupToolResponseJson}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyToolResponseButton"
                                    Grid.Row="0"
                                    Width="160"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyToolResponse}"
                                    Click="CopyToolResponseButton_Click"/>

                            <TextBox x:Name="ToolResponseTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.LastInvocationTabPreFinalAnswer}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static properties:Resources.LastInvocationLabelUserQuestion}"/>

                        <ComboBox x:Name="PreFinalInvocationSelectorComboBox"
                                  Grid.Column="1"
                                  MinWidth="260"
                                  SelectionChanged="PreFinalInvocationSelectorComboBox_SelectionChanged"/>
                    </Grid>

                    <GroupBox Grid.Row="1" Header="{x:Static properties:Resources.LastInvocationGroupPreFinalContext}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyPreFinalContextButton"
                                    Grid.Row="0"
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyContext}"
                                    Click="CopyPreFinalContextButton_Click"/>

                            <TextBox x:Name="PreFinalContextTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.LastInvocationGroupFinalAssistantResponse}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="CopyFinalAssistantResponseButton"
                                    Grid.Row="0"
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6"
                                    Content="{x:Static properties:Resources.LastInvocationButtonCopyAnswer}"
                                    Click="CopyFinalAssistantResponseButton_Click"/>

                            <TextBox x:Name="FinalAssistantResponseTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Width="90"
                    Content="{x:Static properties:Resources.LastInvocationButtonClose}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
