<UserControl x:Class="CrypTool.CrypLLM.LLMSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:CrypTool.CrypLLM.Properties"
             xmlns:local="clr-namespace:CrypTool.CrypLLM"
             xmlns:converter="clr-namespace:CrypTool.CrypLLM.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="800"
             d:DesignWidth="800">

    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ToolPermissionAllowedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="IsEnabled" Value="{Binding CanEditPermission}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPermissionLocked}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding DataContext.AiToolPermissionsLockedTooltipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <TabControl>
                <!-- Keep the settings form compact and aligned at the left edge. -->
                <TabItem Header="{Loc AIChatSettings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <StackPanel Name="stackPanel1" MaxWidth="580" HorizontalAlignment="Left">

                                <Label Content="{Loc AIChatSettings}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Padding="0" Margin="0,0,0,14"/>     

                                <Border BorderBrush="#FFD0D0D0"
                                        BorderThickness="1"
                                        Background="#FFF8F8F8"
                                        CornerRadius="2"
                                        Padding="12"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,14"> 
                                    
                                    <TextBlock Text="{Loc AiDisclaimerText}"
                                            TextWrapping="Wrap" />
                                </Border>

                                

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,0,0,0">
                                    <TextBlock Text="{Loc Provider}"
                                               VerticalAlignment="Center"
                                               Width="180" />
                                    <ComboBox MinHeight="26" Width="320"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Path=SelectedProvider, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="{Loc ProviderOpenAI}"
                                                      Tag="OpenAI" />
                                        <ComboBoxItem Content="{Loc ProviderLocal}"
                                                      Tag="Local" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,6,0,0">
                                    <TextBlock Text="{Loc ReasoningEffort}"
                                               VerticalAlignment="Center"
                                               Width="180" />
                                    <ComboBox MinHeight="26" Width="320"
                                              ItemsSource="{Binding ReasoningOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ReasoningLevel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,6,0,0">
                                    <TextBlock Text="{Loc LlmLogLevel}"
                                               VerticalAlignment="Center"
                                               Width="180" />
                                    <ComboBox MinHeight="26" Width="320"
                                              ItemsSource="{Binding LlmLogLevelOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding LlmLogLevel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,6,0,0">
                                    <CheckBox Content="{Loc ShowAIChatInRibbon}"
                                              IsChecked="{Binding AiChatShowInRibbon, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,6,0,0">
                                    <CheckBox Content="{Loc OpenAIWindowOnStartup}"
                                              IsChecked="{Binding AiChatOpenOnStartup, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="16,6,0,0">
                                    <Button Content="{Loc DeleteAllSavedAIChats}"
                                            Click="DeleteAllChatsButton_Click" Padding="10,4" Margin="0,4,0,0" />
                                </StackPanel>

                                <Separator Margin="0,18,0,12" />

                                <StackPanel Margin="0,0,0,0"
                                            Visibility="{Binding Path=IsOpenAiSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Label Content="{Loc OpenAISection}"
                                           FontWeight="Bold"
                                           Padding="0" Margin="0,0,0,4" />

                                    <StackPanel Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Loc ApiKey}"
                                                       VerticalAlignment="Center"
                                                       Width="180" />
                                            <PasswordBox MinHeight="26" x:Name="ApiKeyBox"
                                                         Width="320"
                                                         PasswordChanged="ApiKeyBox_PasswordChanged" />
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Loc ModelIdList}"
                                                       VerticalAlignment="Top"
                                                       Width="180" />
                                            <TextBox Text="{Binding Path=OpenAiModelIds, UpdateSourceTrigger=LostFocus}"
                                                     AcceptsReturn="True" VerticalContentAlignment="Top"
                                                     HorizontalAlignment="Left"
                                                     MinHeight="96"
                                                     Width="320" VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Loc OrgId}"
                                                       VerticalAlignment="Center"
                                                       Width="180" />
                                            <TextBox MinHeight="26" Text="{Binding Path=OrgId, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="320" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding Path=IsLocalSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Label Content="{Loc LocalModelSection}"
                                           FontWeight="Bold"
                                           Padding="0" Margin="0,0,0,4" />

                                    <StackPanel Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Loc LocalModelEndpoint}"
                                                       VerticalAlignment="Center"
                                                       Width="180" />
                                            <TextBox MinHeight="26" Text="{Binding Path=LocalModelEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="320"
                                                     ToolTip="{Loc LocalModelEndpointTooltip}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0">
                                            <TextBlock Text="{Loc LocalApiKeyLabel}"
                                                       VerticalAlignment="Center"
                                                       Width="180" />
                                            <PasswordBox x:Name="LocalApiKeyBox"
                                                         MinHeight="26" Width="320"
                                                         PasswordChanged="LocalApiKeyBox_PasswordChanged"
                                                         ToolTip="{Loc LocalApiKeyTooltip}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0">
                                            <TextBlock Text="{Loc ModelIdList}"
                                                       VerticalAlignment="Top"
                                                       Width="180" />
                                            <TextBox Text="{Binding Path=LocalModelIds, UpdateSourceTrigger=LostFocus}"
                                                     AcceptsReturn="True" VerticalContentAlignment="Top"
                                                     HorizontalAlignment="Left"
                                                     MinHeight="96"
                                                     Width="320"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Height="96" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,18,0,12" />

                                <StackPanel Margin="0,0,0,0">
                                    <Label Content="{Loc ModelContextWindowSectionTitle}"
                                           FontWeight="Bold"
                                           Padding="0" Margin="0,0,0,4" />

                                    <StackPanel Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Loc ModelContextWindowModelLabel}"
                                                       VerticalAlignment="Center"
                                                        Width="180" />
                                            <ComboBox MinHeight="26" Width="320"
                                                     Margin="0"
                                                     VerticalAlignment="Center"
                                                      ItemsSource="{Binding ContextWindowModelIds}"
                                                      SelectedItem="{Binding SelectedContextWindowModelId, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Loc ModelContextWindowTokensLabel}"
                                                       VerticalAlignment="Center"
                                                       Width="180"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding SelectedModelContextWindowHint}" />
                                            <TextBox MinHeight="26" Text="{Binding Path=SelectedModelContextWindowText, UpdateSourceTrigger=LostFocus}"
                                                     Width="320"
                                                     Margin="0"
                                                     VerticalAlignment="Center"
                                                     IsEnabled="{Binding IsSelectedModelContextWindowEditable}"
                                                     ToolTip="{Binding SelectedModelContextWindowHint}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,18,0,12" />
                                <Label Content="{Loc ContextCompressionSection}"
                                       FontWeight="Bold" Padding="0" Margin="0,0,0,8" />
                                <CheckBox Content="{Loc AutoCompressContextLabel}"
                                          IsChecked="{Binding AutoCompressContext, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="16,0,0,8" />
                                <StackPanel Margin="16,0,0,0" IsEnabled="{Binding AutoCompressContext}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Loc ContextCompressionTriggerLabel}"
                                                   VerticalAlignment="Center" Width="180" />
                                        <TextBox MinHeight="26" Width="100"
                                                 Text="{Binding ContextCompressionTriggerPercent, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                                 ToolTip="{Loc ContextCompressionInvalidPercent}" />
                                        <TextBlock Text="%" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Loc ContextCompressionTargetLabel}"
                                                   VerticalAlignment="Center" Width="180" />
                                        <TextBox MinHeight="26" Width="100"
                                                 Text="{Binding ContextCompressionTargetPercent, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                                 ToolTip="{Loc ContextCompressionInvalidPercent}" />
                                        <TextBlock Text="%" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Loc ContextCompressionHint}" TextWrapping="Wrap"
                                           Foreground="Gray" Margin="16,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Agent Permissions -->
                <TabItem Header="{Loc AiToolPermissionsTab}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="16,0,0,8">
                            <CheckBox IsChecked="{Binding AllowAiToolMutations, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding AllowAiToolMutationsTooltip}" />
                            <TextBlock Text="{Loc AllowAiToolMutationsLabel}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       ToolTip="{Binding AllowAiToolMutationsTooltip}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Loc AiToolPermissionsHint}"
                                   Foreground="Gray"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap" />

                        <ScrollViewer x:Name="ToolPermissionsScrollViewer"
                                      Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ToolPermissionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding PluginDisplayName}"
                                                  PreviewMouseWheel="ToolPermissionsDataGrid_PreviewMouseWheel"
                                                  IsExpanded="True"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PluginDescription}"
                                                           PreviewMouseWheel="ToolPermissionsDataGrid_PreviewMouseWheel"
                                                           Foreground="Gray"
                                                           Margin="0,0,0,6"
                                                           TextWrapping="Wrap" />
                                                <DataGrid ItemsSource="{Binding Permissions}"
                                                          Loaded="ToolPermissionsDataGrid_Loaded"
                                                          PreviewMouseWheel="ToolPermissionsDataGrid_PreviewMouseWheel"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          HeadersVisibility="Column"
                                                          IsReadOnly="False"
                                                          ColumnWidth="SizeToCells">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="ToolTip" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPermissionLocked}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                    <Setter Property="ToolTip" Value="{Binding DataContext.AiToolPermissionsLockedTooltipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn Header="{x:Static p:Resources.AiToolPermissionsAllowed}"
                                                                    Binding="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ElementStyle="{StaticResource ToolPermissionAllowedCheckBoxStyle}"
                                                                    EditingElementStyle="{StaticResource ToolPermissionAllowedCheckBoxStyle}"
                                                                    Width="110"
                                                                    MinWidth="110" />
                                                        <DataGridTextColumn Header="{x:Static p:Resources.AiToolPermissionsMethod}"
                                                                    Binding="{Binding FunctionName}"
                                                                    IsReadOnly="True"
                                                                    Width="280"
                                                                    MinWidth="260" />
                                                        <DataGridTextColumn Header="{Loc AiToolPermissionsMinContextHeader}"
                                                                    Binding="{Binding MinimumContextWindowDisplay, Mode=OneWay}"
                                                                    IsReadOnly="True"
                                                                    Width="130"
                                                                    MinWidth="120" />
                                                        <DataGridTextColumn Header="{x:Static p:Resources.AiToolPermissionsDescription}"
                                                                    Binding="{Binding Description, Mode=OneWay}"
                                                                    IsReadOnly="True"
                                                                    Width="620"
                                                                    MinWidth="520" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Instructions -->
                <TabItem Header="{Loc AgentInstructionsTab}">
                    <Grid x:Name="InstructionsTabGrid"
                          Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Loc InstructionKey}"
                                       VerticalAlignment="Center"
                                       Width="120" />
                            <ComboBox Width="200"
                                      ItemsSource="{Binding InstructionEntries}"
                                      SelectedItem="{Binding SelectedInstruction, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      />
                            <Button Grid.Row="1"
                                    Content="{Loc LoadDefaultText}"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsSelectedInstructionEditable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="LoadDefaultInstructionButton_Click" />
                            <TextBlock Grid.Row="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray">       
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Text" Value="{Loc InstructionIsNotToBeChanged}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedInstructionEditable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedInstructionDefaultStateText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedInstructionUsingDefaultText}" Value="True">
                                                <Setter Property="Foreground" Value="ForestGreen" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelectedInstructionOverLengthLimit}" Value="True">
                                                <Setter Property="Foreground" Value="Crimson" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBox x:Name="InstructionEditorTextBox"
                            Grid.Row="1"
                                 Text="{Binding Path=SelectedInstructionText, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 IsUndoEnabled="True"
                                 UndoLimit="500"
                                 Width="{Binding ElementName=InstructionsTabGrid, Path=ActualWidth}"
                                 MinWidth="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsEnabled="{Binding IsSelectedInstructionEditable}"
                                 TextChanged="InstructionTextBox_TextChanged"
                                 PreviewKeyDown="InstructionTextBox_PreviewKeyDown"
                                 LostFocus="InstructionTextBox_LostFocus" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
